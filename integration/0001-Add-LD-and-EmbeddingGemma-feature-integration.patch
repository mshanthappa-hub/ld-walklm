@@ -0,0 +1,86 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: MIT
+
+"""Load the exact ogbn-products feature stack used by this experiment."""
+
+import os
+from pathlib import Path
+
+import torch
+
+
+EXPECTED_ROWS = 2449029
+EXPECTED_DIMS = {
+    "ld": 768,
+    "walklm": 768,
+    "raw": 100,
+}
+
+
+def _load_local_tensor(path, preferred_key=None):
+    """Load a trusted local tensor (or a one-tensor checkpoint dictionary)."""
+    path = Path(path).expanduser().resolve()
+    if not path.is_file():
+        raise FileNotFoundError("Feature tensor not found: {}".format(path))
+
+    try:
+        value = torch.load(str(path), map_location="cpu", weights_only=True)
+    except TypeError:
+        # PyTorch versions before weights_only was added.
+        value = torch.load(str(path), map_location="cpu")
+
+    if isinstance(value, dict):
+        if preferred_key in value:
+            value = value[preferred_key]
+        else:
+            tensors = [item for item in value.values() if torch.is_tensor(item)]
+            if len(tensors) != 1:
+                raise ValueError(
+                    "Expected one tensor in {}, found keys {}".format(
+                        path, sorted(value.keys())
+                    )
+                )
+            value = tensors[0]
+
+    if not torch.is_tensor(value):
+        raise TypeError("{} did not contain a torch.Tensor".format(path))
+    return value.detach().cpu().float().contiguous()
+
+
+def _validate(name, value, columns):
+    expected = (EXPECTED_ROWS, columns)
+    if tuple(value.shape) != expected:
+        raise ValueError(
+            "{} has shape {}; expected {}".format(name, tuple(value.shape), expected)
+        )
+    if value.dtype != torch.float32:
+        raise TypeError("{} has dtype {}; expected float32".format(name, value.dtype))
+
+
+def load_products_feature_stack(raw_features, ld_path=None, walklm_path=None):
+    """Return [LD BERT, EmbeddingGemma walk-text (WalkLM-style), raw OGB] in that order.
+
+    Paths default to the LD_FEATURE_PATH and WALKLM_FEATURE_PATH environment
+    variables. Tensor files must be trusted because older PyTorch versions
+    may use pickle-backed torch.load behavior.
+    """
+    ld_path = ld_path or os.environ.get("LD_FEATURE_PATH")
+    walklm_path = walklm_path or os.environ.get("WALKLM_FEATURE_PATH")
+    if not ld_path or not walklm_path:
+        raise RuntimeError(
+            "Set LD_FEATURE_PATH and WALKLM_FEATURE_PATH to the two input tensors"
+        )
+
+    raw = raw_features.detach().cpu().float().contiguous()
+    ld = _load_local_tensor(ld_path, preferred_key="hidden_state")
+    walklm = _load_local_tensor(walklm_path, preferred_key="walklm_x")
+
+    _validate("LD hidden state", ld, EXPECTED_DIMS["ld"])
+    _validate("EmbeddingGemma walk-text (WalkLM-style)", walklm, EXPECTED_DIMS["walklm"])
+    _validate("raw OGB features", raw, EXPECTED_DIMS["raw"])
+
+    combined = torch.cat([ld, walklm, raw], dim=1)
+    expected_columns = sum(EXPECTED_DIMS.values())
+    if tuple(combined.shape) != (EXPECTED_ROWS, expected_columns):
+        raise AssertionError("Unexpected combined shape: {}".format(combined.shape))
+    return combined
